# Copia este archivo como .env.local y llena los valores.
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Solo servidor. NUNCA lo expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL pública de la app (se codifica en los QR). Sin "/" al final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Avisos push (Web Push). Genera el par con: npx web-push generate-vapid-keys
# Sin llaves, los avisos solo se registran en la consola.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Protege el endpoint del cron diario (Vercel lo envía como Bearer).
CRON_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
